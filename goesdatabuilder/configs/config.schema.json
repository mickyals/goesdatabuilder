{
    "type": "object",
    "required": [
        "data_access",
        "regridding",
        "store",
        "pipeline"
    ],
    "properties": {
        "data_access": {
            "type": "object",
            "required": [
                "recursive",
                "chunk_size",
                "sample_size",
                "sampling_type",
                "engine",
                "parallel"
            ],
            "properties": {
                "recursive": {
                    "type": "boolean"
                },
                "chunk_size": {
                    "type": [
                        "string",
                        "integer",
                        "null",
                        "object"
                    ],
                    "required": [
                        "time",
                        "x",
                        "y"
                    ],
                    "properties": {
                        "time": {
                            "type": [
                                "string",
                                "integer",
                                "null"
                            ]
                        },
                        "x": {
                            "type": [
                                "string",
                                "integer",
                                "null"
                            ]
                        },
                        "y": {
                            "type": [
                                "string",
                                "integer",
                                "null"
                            ]
                        }
                    }
                },
                "sample_size": {
                    "type": "integer",
                    "minimum": 0
                },
                "sampling_type": {
                    "type": "string",
                    "enum": [
                        "even",
                        "random"
                    ]
                },
                "seed": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "engine": {
                    "type": "string"
                },
                "parallel": {
                    "type": "boolean"
                },
                "file_source": {
                    "type": [
                        "string",
                        "array",
                        "null"
                    ],
                    "minLength": 1,
                    "minItems": 1
                }
            }
        },
        "regridding": {
            "type": "object",
            "required": [
                "decimals"
            ],
            "properties": {
                "weights_dir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "decimals": {
                    "type": "integer"
                }
            }
        },
        "store": {
            "type": "object",
            "required": [
                "type",
                "path",
                "presets"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "local",
                        "zip",
                        "fsspec",
                        "memory",
                        "object"
                    ]
                },
                "path": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "storage_options": {
                    "type": "object"
                },
                "presets": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "compressors": {
                                "anyOf": [
                                    {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/$defs/codec"
                                        }
                                    },
                                    {
                                        "type": "string",
                                        "const": "auto"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "serializer": {
                                "anyOf": [
                                    {
                                        "$ref": "#/$defs/codec"
                                    },
                                    {
                                        "type": "string",
                                        "const": "auto"
                                    }
                                ]
                            },
                            "filter": {
                                "anyOf": [
                                    {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/$defs/codec"
                                        }
                                    },
                                    {
                                        "type": "string",
                                        "const": "auto"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "chunks": {
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "const": "auto"
                                    },
                                    {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        }
                                    }
                                ]
                            },
                            "shards": {
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "const": "auto"
                                    },
                                    {
                                        "type": "null"
                                    },
                                    {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        }
                                    }
                                ]
                            },
                            "fill_value": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            }
                        }
                    }
                }
            },
            "if": {
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "object"
                    }
                }
            },
            "then": {
                "required": [
                    "storage_options",
                    "object_store_backend"
                ],
                "properties": {
                    "object_store_backend": {
                        "type": "string"
                    }
                },
                "anyOf": [
                    {
                        "properties": {
                            "object_store_backend": {
                                "enum": [
                                    "s3",
                                    "gcs"
                                ]
                            },
                            "storage_options": {
                                "required": [
                                    "bucket"
                                ],
                                "properties": {
                                    "bucket": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    },
                    {
                        "properties": {
                            "object_store_backend": {
                                "const": "azure"
                            },
                            "storage_options": {
                                "required": [
                                    "container",
                                    "account"
                                ],
                                "properties": {
                                    "container": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "account": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    },
                    {
                        "properties": {
                            "object_store_backend": {
                                "const": "memory"
                            }
                        }
                    }
                ]
            }
        },
        "pipeline": {
            "type": "object",
            "required": [
                "worker_threads",
                "error_handling",
                "progress",
                "logging",
                "overwrite"
            ],
            "properties": {
                "worker_threads": {
                    "type": "integer",
                    "minimum": 1
                },
                "overwrite": {
                    "type": "boolean"
                },
                "error_handling": {
                    "type": "object",
                    "required": [
                        "continue_on_error",
                        "max_retries"
                    ],
                    "properties": {
                        "continue_on_error": {
                            "type": "boolean"
                        },
                        "max_retries": {
                            "type": "integer",
                            "minimum": 0
                        }
                    }
                },
                "progress": {
                    "type": "object",
                    "required": [
                        "show_progress",
                        "log_interval"
                    ],
                    "properties": {
                        "show_progress": {
                            "type": "boolean"
                        },
                        "log_interval": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                },
                "logging": {
                    "type": "object",
                    "required": [
                        "level",
                        "format",
                        "date_format"
                    ],
                    "properties": {
                        "level": {
                            "type": "string",
                            "enum": [
                                "NOTSET",
                                "DEBUG",
                                "INFO",
                                "WARNING",
                                "ERROR",
                                "CRITICAL"
                            ]
                        },
                        "format": {
                            "type": "string"
                        },
                        "date_format": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "resolution": {
            "type": "number",
            "minimum": 0
        },
        "codec": {
            "type": "object",
            "required": [
                "codec"
            ],
            "properties": {
                "codec": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "kwargs": {
                    "type": "object"
                }
            }
        }
    }
}